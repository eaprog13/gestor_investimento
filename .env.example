# Copia este ficheiro para ".env" e ajusta os valores.
#
# Em desenvolvimento local (npm run dev), aponta o DATABASE_URL para o
# Postgres do docker-compose publicado em localhost:
#   docker compose up -d db
#   DATABASE_URL="postgresql://gi:change-me@localhost:5432/gestor_investimento"
#
# Dentro do docker-compose (serviços migrate/app), o host é o nome do
# serviço "db", não "localhost" — ver docker-compose.yml.

POSTGRES_USER=gi
POSTGRES_PASSWORD=change-me
DATABASE_URL="postgresql://gi:change-me@localhost:5432/gestor_investimento"

# Gera com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=generate-a-long-random-32-byte-hex-value

# Utilizador inicial, criado/atualizado por "npx prisma db seed".
INITIAL_USER_EMAIL=exemplo@familia.pt
INITIAL_USER_PASSWORD=change-me
INITIAL_USER_NAME=Nome Apelido
