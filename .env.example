# Copia este ficheiro para ".env" e ajusta os valores.
#
# Cria o projeto em https://supabase.com → Project Settings → API, e depois
# aplica supabase/schema.sql + supabase/policies.sql (SQL Editor do
# projeto). Ver README.md, secção "Base de dados e autenticação (Supabase)".

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...              # chave pública — usada só pelo proxy (renovação de sessão) e no login
# Chave privada — nunca expor ao browser. Usada em todo o acesso a dados de
# negócio e na Admin API (nome das contas) — ver src/adapters/supabase/clienteAdmin.ts.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Utilizador inicial, criado/atualizado por "npm run seed" (supabase/seed.ts).
INITIAL_USER_EMAIL=exemplo@familia.pt
INITIAL_USER_PASSWORD=change-me
INITIAL_USER_NAME=Nome Apelido

# "true" para semear 3 ativos de demonstração (só em dev — nunca em prod).
SEED_DEMO_DATA=false

# ──────────────────────────────────────────────────────────────────────────
# Rate limiting do login (OBRIGATÓRIO em produção) — Upstash Redis
# https://upstash.com (plano free chega perfeitamente para isto).
# Sem isto definido, o limite fica só em memória (por instância do servidor).
# ──────────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ──────────────────────────────────────────────────────────────────────────
# Cotação ao vivo dos ativos (opcional) — ver README.md, secção "Cotações
# ao vivo". CoinGecko (cripto) não precisa de chave. Alpha Vantage (ETF/
# ações) precisa de uma chave grátis: https://www.alphavantage.co/support/#api-key
# (plano free: ~25 pedidos/dia — a app já faz cache de 24h por ativo).
# ──────────────────────────────────────────────────────────────────────────
ALPHA_VANTAGE_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Segredo para assinar o cookie de atividade da sessão (opcional). Sem ele,
# usa uma chave derivada da SUPABASE_SERVICE_ROLE_KEY. Mudá-lo termina todas
# as sessões abertas. Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ──────────────────────────────────────────────────────────────────────────
SESSION_ACTIVITY_SECRET=
